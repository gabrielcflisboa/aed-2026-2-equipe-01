	<groupId>br.pucminas.aed</groupId>
	<artifactId>servico-ingressos</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>servico-ingressos</name>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
